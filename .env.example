# Duck Cosmetics — Production Environment Variables

# 1. Google Firebase (Authentication & Cloud Firestore Database)
# Unlimited login testing (No 3 emails/hour Supabase rate limit)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id

# 2. Cloudinary CDN Image Storage (Unlimited Product Images, Logos & Banners)
VITE_CLOUDINARY_CLOUD_NAME=fddgundt
VITE_CLOUDINARY_UPLOAD_PRESET=duck_unsigned_preset

# 3. Payment Gateway Integrations
# Stripe (Global Cards, Apple Pay, Google Pay)
VITE_STRIPE_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# Razorpay (UPI, Netbanking, Rupay, EMI)
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# PhonePe Gateway
PHONEPE_MERCHANT_ID=your-phonepe-merchant-id
PHONEPE_SALT_KEY=your-phonepe-salt-key
PHONEPE_SALT_INDEX=1

# 4. Logistics & Carrier Integrations
SHIPROCKET_API_TOKEN=your-shiprocket-bearer-token
DELHIVERY_API_KEY=your-delhivery-client-token

# 5. WhatsApp & SMS Notification Service (Twilio / Gupshup / Fast2SMS)
SMS_API_KEY=your-sms-api-key
WHATSAPP_API_TOKEN=your-whatsapp-business-api-token

# 6. Production Store Configuration & Security
VITE_PUBLIC_STORE_URL=https://duckcosmetics.in
VITE_ADMIN_ACCESS_SECRET=duck-admin-secret-key-2026
ADMIN_SESSION_SECRET=long-random-sha256-string-for-session-signing
