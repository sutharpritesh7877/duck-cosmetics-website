# ==============================================================================
# 🦆 Duck Cosmetics — Production Environment Variables Template
# ==============================================================================
# Copy this file to `.env.local` for local development.
# For Vercel Deployment, add these in:
# Vercel Project -> Settings -> Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base App & Canonical URLs
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# Canonical Storefront URL (In Vercel, change to your live domain e.g. https://duckcosmetics.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NextAuth Canonical URL (Must match your live domain e.g. https://duckcosmetics.com)
NEXTAUTH_URL=http://localhost:3000

# Random 32+ character string for NextAuth session encryption (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=duck-cosmetics-super-secret-jwt-key-2026-high-fashion
JWT_SECRET=duck-cosmetics-super-secret-jwt-key-2026-high-fashion

# ------------------------------------------------------------------------------
# 2. Executive Admin Portal Credentials
# ------------------------------------------------------------------------------
DEFAULT_ADMIN_EMAIL=admin@duckcosmetics.com
DEFAULT_ADMIN_PASSWORD=DuckAdmin2026!

# ------------------------------------------------------------------------------
# 3. Google OAuth 2.0 (For Customer "Continue with Google" Sign-In)
# ------------------------------------------------------------------------------
# Setup in Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth Client ID
# Authorized Javascript Origins: http://localhost:3000, https://your-domain.com
# Authorized Redirect URI: http://localhost:3000/api/auth/callback/google, https://your-domain.com/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# ------------------------------------------------------------------------------
# 4. Database Engine (PostgreSQL / Supabase / Neon / Vercel Postgres)
# ------------------------------------------------------------------------------
# If left blank, Duck Cosmetics runs automatically on its high-speed local store (.data/store.json).
# For cloud production, use a PostgreSQL connection string:
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.vkrdmkvzcxrxazvpcevl.supabase.co:5432/postgres?sslmode=require
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.vkrdmkvzcxrxazvpcevl.supabase.co:5432/postgres?sslmode=require

# Supabase Public Keys
NEXT_PUBLIC_SUPABASE_URL=https://vkrdmkvzcxrxazvpcevl.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_MaTMvQEOTRL9y5g2QGsf_A__C6xgrIs

# ------------------------------------------------------------------------------
# 5. Cloud Asset Storage: Firebase Storage (Primary) & Cloudinary (Secondary)
# ------------------------------------------------------------------------------
# Firebase Web App & Cloud Storage Bucket (Supports both NEXT_PUBLIC_ and VITE_ prefixes in Vercel)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBv6mfcawOiiAkIZFEW6fjaP-w9ZDHpWsU
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=duck-cosmetics-a4f4b.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=duck-cosmetics-a4f4b
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=duck-cosmetics-a4f4b.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=440189309657
NEXT_PUBLIC_FIREBASE_APP_ID=1:440189309657:web:6cbb4a7814c0af5b0224c8
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-ZX4SQ65QNH

# Also supported with VITE_ prefix (as configured in your Vercel Dashboard):
VITE_FIREBASE_API_KEY=AIzaSyBv6mfcawOiiAkIZFEW6fjaP-w9ZDHpWsU
VITE_FIREBASE_AUTH_DOMAIN=duck-cosmetics-a4f4b.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=duck-cosmetics-a4f4b
VITE_FIREBASE_STORAGE_BUCKET=duck-cosmetics-a4f4b.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=440189309657
VITE_FIREBASE_APP_ID=1:440189309657:web:6cbb4a7814c0af5b0224c8

# Cloudinary CDN Configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=fddgundt
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=duck_unsigned_preset
VITE_CLOUDINARY_CLOUD_NAME=fddgundt
VITE_CLOUDINARY_UPLOAD_PRESET=duck_unsigned_preset
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# 6. Payment Gateways (Razorpay & Stripe)
# ------------------------------------------------------------------------------
# Razorpay Merchant Gateway (INR Checkout)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder

# Stripe Gateway (Global International Cards)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder

# ------------------------------------------------------------------------------
# 7. Atelier Concierge & Transactional Emails
# ------------------------------------------------------------------------------
EMAIL_FROM="Duck Cosmetics Atelier <concierge@duckcosmetics.com>"
ADMIN_NOTIFICATION_EMAIL=admin@duckcosmetics.com
BREVO_API_KEY=
